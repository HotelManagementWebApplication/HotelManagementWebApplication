# Local/demo agent configuration. Copy this file to .env for local use.
# Keep real credentials out of this template and out of source control.

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Models used for response generation and vector embeddings.
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Local Qdrant connection. Authentication is optional for local development.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=customer_policy
QDRANT_API_KEY=

# Local backend, agent, and browser client endpoints.
BACKEND_API_BASE_URL=http://localhost:8080
AGENT_PORT=8090
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
