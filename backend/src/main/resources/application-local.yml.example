spring:
  datasource:
    url: ${DB_URL:jdbc:sqlserver://localhost:1433;databaseName=QLKS;encrypt=true;trustServerCertificate=true}
    username: ${DB_USERNAME:sa}
    password: ${DB_PASSWORD:}
    hikari:
      maximum-pool-size: ${DB_POOL_SIZE:10}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
      naming:
        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
    properties:
      hibernate:
        jdbc:
          time_zone: Asia/Ho_Chi_Minh
        use_nationalized_character_data: true
  flyway:
    enabled: true
    locations: classpath:db/migration

hotel:
  payment:
    vnpay:
      # Nhận từ email kích hoạt VNPay Sandbox. Không commit giá trị thật.
      tmn-code: ${VNPAY_TMN_CODE:}
      hash-secret: ${VNPAY_HASH_SECRET:}
      payment-url: ${VNPAY_PAYMENT_URL:https://sandbox.vnpayment.vn/paymentv2/vpcpay.html}
      # VNPay phải gọi được URL HTTPS public này; trỏ tunnel về localhost:8080.
      return-url: ${VNPAY_RETURN_URL:http://localhost:8080/api/public/payments/vnpay/return}
      frontend-result-url: ${VNPAY_FRONTEND_RESULT_URL:http://localhost:5173/payment/vnpay-result}
  policy:
    hourly-minimum: ${HOTEL_HOURLY_MINIMUM:3}
    late-checkout-grace-minutes: ${HOTEL_LATE_GRACE_MINUTES:20}
    vip-discount-percent: ${HOTEL_VIP_DISCOUNT_PERCENT:10}
    vip-stay-threshold: ${HOTEL_VIP_STAY_THRESHOLD:10}

server:
  port: ${SERVER_PORT:8080}
