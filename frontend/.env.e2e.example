# Copy to frontend/.env.e2e and replace every placeholder with disposable-test values.
# Never commit the copied file, passwords, tokens, or production identifiers.

E2E_API_BASE_URL=<http://127.0.0.1:8080>
E2E_SQLSERVER_DISPOSABLE=<true>
E2E_SQLSERVER_DATABASE=<e2e_live_contract_YYYYMMDD>

# Customer registration and reservation inputs
E2E_CUSTOMER_PHONE=<unique-test-phone>
E2E_CUSTOMER_PASSWORD=<unique-test-password>
E2E_CUSTOMER_FULL_NAME=<test-customer-name>
E2E_CUSTOMER_IDENTITY_NUMBER=<unique-test-identity-number>
E2E_CUSTOMER_ROOM_ID=<available-room-id-or-code>
E2E_CUSTOMER_CHECK_IN=<2031-01-10T14:00:00>
E2E_CUSTOMER_CHECK_OUT=<2031-01-11T12:00:00>
E2E_CUSTOMER_FOREIGN_RESERVATION_ID=<positive-reservation-id-owned-by-another-customer>

# Front Desk checkout fixture
E2E_FRONT_DESK_EMPLOYEE_ID=<front-desk-employee-id>
E2E_FRONT_DESK_PASSWORD=<front-desk-password>
E2E_FRONT_DESK_RESERVATION_ID=<checked-in-reservation-id>
E2E_FRONT_DESK_CHECK_IN_AT=<2031-01-10T14:00:00>
E2E_FRONT_DESK_CHECK_OUT_AT=<2031-01-11T12:00:00>

# Housekeeping -> Technical -> Manager fixture
E2E_HOUSEKEEPING_EMPLOYEE_ID=<housekeeping-employee-id>
E2E_HOUSEKEEPING_PASSWORD=<housekeeping-password>
E2E_TECHNICAL_EMPLOYEE_ID=<technical-employee-id>
E2E_TECHNICAL_PASSWORD=<technical-password>
E2E_MANAGER_EMPLOYEE_ID=<manager-employee-id>
E2E_MANAGER_PASSWORD=<manager-password>
E2E_WORK_ORDER_ID=<new-technical-work-order-id>
E2E_WORK_ORDER_ROOM_ID=<room-id-with-complete-housekeeping-handoff>

# Kitchen service stock and price approval fixture
E2E_KITCHEN_EMPLOYEE_ID=<kitchen-employee-id>
E2E_KITCHEN_PASSWORD=<kitchen-password>
E2E_SERVICE_ID=<service-id>
E2E_KITCHEN_STOCK_QUANTITY=<positive-integer>
E2E_NEW_SERVICE_PRICE=<positive-price>

# Accounting payment and pre-approved refund fixture
E2E_ACCOUNTING_EMPLOYEE_ID=<accounting-employee-id>
E2E_ACCOUNTING_PASSWORD=<accounting-password>
E2E_ACCOUNTING_INVOICE_ID=<positive-invoice-id>
E2E_ACCOUNTING_PAYMENT_AMOUNT=<positive-payment-amount>
E2E_ACCOUNTING_REFUND_AMOUNT=<positive-refund-amount-not-greater-than-payment>
E2E_ACCOUNTING_REFUND_KEY=<unique-idempotency-key-1-to-35-ascii-chars>
E2E_ACCOUNTING_REFUND_APPROVAL_ID=<approved-payment-refund-approval-id>
E2E_DIRECTOR_EMPLOYEE_ID=<director-employee-id>
E2E_DIRECTOR_PASSWORD=<director-password>

# HR/Admin permission ceiling fixture
E2E_ADMIN_EMPLOYEE_ID=<admin-employee-id>
E2E_ADMIN_PASSWORD=<admin-password>
E2E_HR_EMPLOYEE_ID=<hr-employee-id>
E2E_HR_PASSWORD=<hr-password>
